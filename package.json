{
  "name": "sme-supply-chain-intelligence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:vercel": "npx vercel dev",
    "sync:opendart": "node --experimental-strip-types scripts/sync-opendart-financials.ts",
    "sync:sec-companyfacts": "node --experimental-strip-types scripts/sync-sec-companyfacts.ts",
    "sync:sec-form4": "node --experimental-strip-types scripts/sync-sec-form4.ts",
    "sync:sec-13f": "node --experimental-strip-types scripts/sync-sec-13f.ts",
    "sync:congress": "node --experimental-strip-types scripts/sync-congress-trades.ts",
    "sync:financials": "npm run sync:opendart && npm run sync:sec-companyfacts",
    "sync:trades": "npm run sync:sec-form4 && npm run sync:sec-13f && npm run sync:congress",
    "sync:all": "npm run sync:financials && npm run sync:trades"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@xyflow/react": "^12.6.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.3"
  }
}
