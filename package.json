{
  "name": "sme-supply-chain-intelligence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:ci && npm run build:app",
    "build:app": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "validate:content": "tsc -p tsconfig.scripts.json && node .sync-build/scripts/validate-content.js",
    "validate:editorial": "tsc -p tsconfig.scripts.json && node .sync-build/scripts/editorial-unit.js",
    "validate:thinking-lab": "tsc -p tsconfig.scripts.json && node .sync-build/scripts/investment-thinking-unit.js",
    "validate:financials": "tsc -p tsconfig.scripts.json && node .sync-build/scripts/financial-pivot-unit.js",
    "validate:multiples": "tsc -p tsconfig.scripts.json && node .sync-build/scripts/market-multiple-unit.js",
    "validate:filing-freshness": "tsc -p tsconfig.scripts.json && node .sync-build/scripts/filing-freshness-unit.js",
    "validate:company-briefs": "tsc -p tsconfig.scripts.json && node .sync-build/scripts/company-brief-unit.js",
    "validate:company-dissections": "tsc -p tsconfig.scripts.json && node .sync-build/scripts/company-dissection-unit.js",
    "qa:phase5g": "node scripts/phase5g-browser-qa.mjs",
    "validate:valuation": "tsc -p tsconfig.scripts.json && node .sync-build/scripts/valuation-unit.js",
    "validate:valuation-expectations": "tsc -p tsconfig.scripts.json && node .sync-build/scripts/valuation-expectations-unit.js",
    "validate:event-impacts": "tsc -p tsconfig.scripts.json && node .sync-build/scripts/event-impact-unit.js",
    "validate:analytics": "tsc -p tsconfig.scripts.json && node .sync-build/scripts/analytics-unit.js",
    "validate:research-reports": "tsc -p tsconfig.scripts.json && node .sync-build/scripts/research-report-unit.js",
    "check:types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check:ci": "npm run validate:content && npm run check:types",
    "test:industry-flows": "npm run sync:compile && node .sync-build/scripts/industry-flow-unit.js",
    "test:market-map-retirement": "npm run sync:compile && node .sync-build/scripts/market-map-retirement-unit.js",
    "test:company-profiles": "npm run sync:compile && node .sync-build/scripts/company-profile-unit.js",
    "test:company-events": "npm run sync:compile && node .sync-build/scripts/company-events-unit.js",
    "test:dependency-security": "npm run sync:compile && node .sync-build/scripts/dependency-security-unit.js",
    "test:javascript-bundle": "npm run sync:compile && node .sync-build/scripts/javascript-bundle-unit.js",
    "report:javascript-bundle": "npm run sync:compile && node .sync-build/scripts/javascript-bundle-report.js",
    "generate:monte-carlo": "npm run sync:compile && node .sync-build/scripts/generate-monte-carlo-artifacts.js",
    "validate:monte-carlo": "npm run sync:compile && node .sync-build/scripts/monte-carlo-unit.js",
    "release:gate": "node scripts/run-release-gate.mjs",
    "release:smoke": "npm run sync:compile && node .sync-build/scripts/release-smoke.js",
    "dev:vercel": "npx vercel dev",
    "sync:compile": "tsc -p tsconfig.scripts.json",
    "sync:opendart": "npm run sync:compile && node .sync-build/scripts/sync-opendart-financials.js",
    "sync:sec-companyfacts": "npm run sync:compile && node .sync-build/scripts/sync-sec-companyfacts.js",
    "sync:sec-form4": "npm run sync:compile && node .sync-build/scripts/sync-sec-form4.js",
    "sync:sec-13f": "npm run sync:compile && node .sync-build/scripts/sync-sec-13f.js",
    "sync:congress": "npm run sync:compile && node .sync-build/scripts/sync-congress-trades.js",
    "sync:prices": "npm run sync:compile && node .sync-build/scripts/sync-prices.js",
    "sync:disclosures": "npm run sync:compile && node .sync-build/scripts/sync-disclosures.js",
    "sync:sec-filings": "npm run sync:compile && node .sync-build/scripts/sync-sec-filings.js",
    "audit:filings": "npm run sync:compile && node .sync-build/scripts/audit-filing-links.js",
    "audit:companies": "npm run sync:compile && node .sync-build/scripts/audit-company-listing-status.js",
    "audit:listings": "npm run sync:compile && node .sync-build/scripts/audit-company-listing-status.js",
    "sync:filing-links": "npm run sync:compile && node .sync-build/scripts/sync-filing-links.js",
    "sync:financials": "npm run sync:opendart && npm run sync:sec-companyfacts",
    "sync:trades": "npm run sync:sec-form4 && npm run sync:sec-13f && npm run sync:congress",
    "sync:all": "npm run sync:financials && npm run sync:trades && npm run sync:prices"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  }
}
