{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/sync/financials",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/sync/trades",
      "schedule": "0 3 * * 1-5"
    },
    {
      "path": "/api/sync/prices",
      "schedule": "30 8 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/analysis",
      "destination": "/"
    },
    {
      "source": "/analysis/:path*",
      "destination": "/"
    },
    {
      "source": "/picks",
      "destination": "/"
    },
    {
      "source": "/picks/:path*",
      "destination": "/"
    },
    {
      "source": "/stock-autopsy-picks",
      "destination": "/"
    },
    {
      "source": "/stock-autopsy-picks/:path*",
      "destination": "/"
    },
    {
      "source": "/ownership-trades",
      "destination": "/"
    },
    {
      "source": "/ownership-trades/:path*",
      "destination": "/"
    },
    {
      "source": "/ko",
      "destination": "/"
    },
    {
      "source": "/ko/",
      "destination": "/"
    },
    {
      "source": "/ko/:path*",
      "destination": "/"
    }
  ]
}
