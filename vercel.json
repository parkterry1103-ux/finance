{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/analysis",
      "destination": "/"
    },
    {
      "source": "/analysis/:path*",
      "destination": "/"
    },
    {
      "source": "/ko",
      "destination": "/"
    },
    {
      "source": "/ko/:path*",
      "destination": "/"
    }
  ]
}
